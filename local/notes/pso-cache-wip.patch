+// The child inherits LEONIDA_PIPELINE_CACHE, creates its own device and synthetic library, and checks driver feedback.
+bool check_fresh_process() {
+    wchar_t exe[32768]{};
+    const DWORD length = GetModuleFileNameW(nullptr, exe, DWORD(std::size(exe)));
+    if (!length || length >= std::size(exe)) return false;
+    std::wstring command = L"\"" + std::wstring(exe) + L"\" --warm";
+    STARTUPINFOW startup{sizeof(startup)};
+    PROCESS_INFORMATION process{};
+    if (!CreateProcessW(exe, command.data(), nullptr, nullptr, TRUE, 0, nullptr, nullptr, &startup, &process))
+        return false;
+    DWORD result = 1;
+    if (WaitForSingleObject(process.hProcess, 60000) == WAIT_OBJECT_0)
+        GetExitCodeProcess(process.hProcess, &result);
+    else
+        TerminateProcess(process.hProcess, 1);
+    CloseHandle(process.hThread);
+    CloseHandle(process.hProcess);
+    return result == 0;
+}
