+// Serialize the read/merge/replace transaction across overlapping sessions. Windows releases an abandoned mutex.
+class SessionCacheWriter {
+public:
+    SessionCacheWriter() {
+        if (mutex_) {
+            const DWORD result = WaitForSingleObject(mutex_, 5000);
+            acquired_ = result == WAIT_OBJECT_0 || result == WAIT_ABANDONED;
+        }
+    }
+    ~SessionCacheWriter() {
+        if (acquired_) ReleaseMutex(mutex_);
+        if (mutex_) CloseHandle(mutex_);
+    }
+    bool acquired() const { return acquired_; }
+private:
+    HANDLE mutex_ = CreateMutexW(nullptr, FALSE, L"Local\\LeonidaPipelineCacheWriter");
+    bool acquired_ = false;
+};
