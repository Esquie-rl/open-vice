+// Compare resolved components, including the volume, using Windows filename case rules.
+bool inside_game_directory(const std::filesystem::path& destination) {
+    namespace store = leonida::pipeline_cache_store;
+    const auto game = rt::fs::game_dir();
+    if (game.empty()) return false;
+    const auto root = store::resolved(game);
+    const auto path = store::resolved(destination);
+    auto part = path.begin();
+    for (const auto& component : root) {
+        if (component.empty()) continue;
+        if (part == path.end() ||
+            CompareStringOrdinal(part->c_str(), -1, component.c_str(), -1, TRUE) != CSTR_EQUAL) return false;
+        ++part;
+    }
+    return true;
+}
